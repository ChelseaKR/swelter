msgid " (provisional, not yet calibrated)"
msgstr " (provisional, aún sin calibrar)"

#, python-brace-format
msgid ", as of {bucket}."
msgstr ", a partir de {bucket}."

#, python-brace-format
msgid "{area}: air quality is {severity} (AQI {aqi}){provisional}{as_of}"
msgstr "{area}: la calidad del aire es {severity} (AQI {aqi}){provisional}{as_of}"

#, python-brace-format
msgid ""
"{area}: heat index is in the {severity} range ({value} "
"°C){provisional}{as_of}"
msgstr ""
"{area}: el índice de calor está en el rango {severity} ({value} "
"°C){provisional}{as_of}"

#, python-brace-format
msgid "{area}: wind chill is {value} °C ({severity}){provisional}{as_of}"
msgstr "{area}: la sensación térmica es {value} °C ({severity}){provisional}{as_of}"

#, python-brace-format
msgid "{area}: combined heat-and-air exposure is {severity}{provisional}{as_of}"
msgstr "{area}: la exposición combinada de calor y aire es {severity}{provisional}{as_of}"

msgid ""
"Public, aggregate environmental alerts — no account, no PII. Subscribe "
"via the Atom feed at /api/alerts.xml in any reader; live servers accept "
"?area=<area_id>."
msgstr ""
"Alertas ambientales públicas y agregadas — sin cuenta, sin datos "
"personales. Suscríbete al feed Atom en /api/alerts.xml con cualquier "
"lector; los servidores en vivo aceptan ?area=<area_id>."

#, python-brace-format
msgid "{network} — heat & air-quality alerts"
msgstr "{network} — alertas de calor y calidad del aire"

msgid ""
"Areas where heat or air quality has crossed a public-health danger "
"threshold. Aggregate environmental data, no PII."
msgstr ""
"Zonas donde el calor o la calidad del aire superó un umbral de peligro "
"de salud pública. Datos ambientales agregados, sin datos personales."

#, python-brace-format
msgid " (last reported {bucket})"
msgstr " (último reporte {bucket})"

#, python-brace-format
msgid " (last reported {bucket}, {hours} h before this feed)"
msgstr " (último reporte {bucket}, {hours} h antes de este feed)"

msgid " The danger alert published for this area is withdrawn, not cleared: swelter has no current reading there."
msgstr " La alerta de peligro publicada para esta zona queda retirada, no cancelada: swelter no tiene una lectura actual allí."

#, python-brace-format
msgid "{area}: no current air-quality reading{age}. swelter cannot tell whether the air there is dangerous now.{withdrawn}"
msgstr "{area}: sin lectura actual de calidad del aire{age}. swelter no puede saber si el aire allí es peligroso ahora.{withdrawn}"

#, python-brace-format
msgid "{area}: no current heat-index reading{age}. swelter cannot tell whether the heat there is dangerous now.{withdrawn}"
msgstr "{area}: sin lectura actual del índice de calor{age}. swelter no puede saber si el calor allí es peligroso ahora.{withdrawn}"

#, python-brace-format
msgid "{area}: no current wind-chill reading{age}. swelter cannot tell whether the cold there is dangerous now.{withdrawn}"
msgstr "{area}: sin lectura actual de sensación térmica por frío{age}. swelter no puede saber si el frío allí es peligroso ahora.{withdrawn}"

#, python-brace-format
msgid "{area}: no current heat-and-air exposure reading{age}. swelter cannot tell whether the exposure there is dangerous now.{withdrawn}"
msgstr "{area}: sin lectura actual de exposición combinada de calor y aire{age}. swelter no puede saber si la exposición allí es peligrosa ahora.{withdrawn}"

msgid "Areas listed under 'stale' have stopped reporting: swelter cannot tell whether they are safe. An empty 'alerts' list means no currently reporting area crossed a danger floor, not that every area is fine."
msgstr "Las zonas incluidas en 'stale' han dejado de reportar: swelter no puede saber si son seguras. Una lista 'alerts' vacía significa que ninguna zona que reporta actualmente cruzó un umbral de peligro, no que todas las zonas estén bien."
