{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChelseaKR/swelter/schemas/sample-health.schema.json",
  "title": "swelter network-health payload",
  "description": "The Python↔JS contract for `/api/health.json` and `web/sample-health.json` — per-node liveness/QC status and gap list. Emitted by `qc.health_report`; consumed by `web/app.js` `renderHealthDetail()` / `healthLine()` / `coverageLine()`. A deliberate field change on either side must edit this schema and both validating tests in the same PR (FIX-07). An optional `calibration` block (present only when a correction registry is available) carries per-correction drift ages; consumers may ignore it.",
  "type": "object",
  "required": ["interval_s", "summary", "nodes", "gaps"],
  "additionalProperties": true,
  "properties": {
    "interval_s": { "type": "number" },
    "latest": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["total", "ok", "degraded", "offline"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "ok": { "type": "integer", "minimum": 0 },
        "degraded": { "type": "integer", "minimum": 0 },
        "offline": { "type": "integer", "minimum": 0 }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/nodeHealth" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "coverage_equity": { "type": "object" },
    "calibration": {
      "type": "object",
      "description": "Descriptive correction-drift surveillance (FIX-03): each calibrated node/parameter correction's age against the latest observation, flagged past the drift horizon. Never a value change or a neighborhood ranking. Present only when a correction registry is supplied.",
      "required": ["horizon_days", "summary", "corrections"],
      "additionalProperties": true,
      "properties": {
        "horizon_days": { "type": "number", "exclusiveMinimum": 0 },
        "summary": {
          "type": "object",
          "required": ["corrections", "aging", "fresh"],
          "properties": {
            "corrections": { "type": "integer", "minimum": 0 },
            "aging": { "type": "integer", "minimum": 0 },
            "fresh": { "type": "integer", "minimum": 0 }
          }
        },
        "corrections": {
          "type": "array",
          "items": { "$ref": "#/$defs/correctionAge" }
        },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "correctionAge": {
      "type": "object",
      "required": ["node_id", "parameter", "version", "window_end", "age_days", "aging"],
      "additionalProperties": true,
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "parameter": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "window_end": { "type": "string" },
        "age_days": { "type": "number" },
        "aging": { "type": "boolean" }
      }
    },
    "nodeHealth": {
      "type": "object",
      "required": [
        "node_id",
        "status",
        "observations",
        "completeness",
        "flagged_fraction",
        "online",
        "last_seen"
      ],
      "additionalProperties": true,
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "degraded", "offline"] },
        "observations": { "type": "integer", "minimum": 0 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "flagged_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "online": { "type": "boolean" },
        "last_seen": { "type": ["string", "null"] }
      }
    },
    "gap": {
      "type": "object",
      "required": ["node_id", "parameter", "start", "end", "minutes"],
      "additionalProperties": true,
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "parameter": { "type": "string", "minLength": 1 },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "minutes": { "type": "number", "minimum": 0 }
      }
    }
  }
}
