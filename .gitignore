# The committed demo data under data/demo/ is reproducible (scripts/gen_demo_data.py);
# the runtime store it gets replayed into is not, so it is ignored.
store/
*.db
*.sqlite
network.real.yaml  # written by `swelter fetch` from live open data; not committed
web/sensors/       # the second live-demo page (Sensor.Community); assembled in CI, not committed

# python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
mutants/

# firmware build artifacts
firmware/build/

# web/ dev-only test tooling (FIX-07) — node_modules is never a runtime dependency of the
# framework-free dashboard; package-lock.json is committed so CI installs the exact locked tree.
web/node_modules/

# infra: provider binaries and local state/secrets are local; lockfiles are committed
**/.terraform/
*.tfstate
*.tfstate.*
cdk.out/

# editors / os
.DS_Store
.env
CLAUDE.local.md
CLAUDE-*.md
.claude/settings.local.json
.claude/worktrees/
